# Used by Caddy only through the route you add to QuotePilot's Caddyfile.
SUPPORTBENCH_DOMAIN=supportbench.duckdns.org

# This database/user must be created inside QuotePilot's existing Postgres container.
SUPPORTBENCH_POSTGRES_DB=supportbench
SUPPORTBENCH_POSTGRES_USER=supportbench
SUPPORTBENCH_POSTGRES_PASSWORD=replace-with-a-long-random-password

# Set this to your Vercel frontend origin after deployment.
CORS_ALLOWED_ORIGINS=https://supportbench-ragops.vercel.app

# Keep portfolio deployment cheap and stable by default.
USE_REAL_MODELS=false
DEFAULT_ANSWER_MODEL=openai_primary
EVAL_JUDGE_PROVIDER=deterministic

# Optional live provider keys. Leave blank unless you want public live benchmarks.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Pinecone retrieval. Local dense + BM25 retrieval is used when false.
USE_PINECONE=false
PINECONE_API_KEY=
PINECONE_INDEX=supportbench-ragops-integrated
PINECONE_NAMESPACE=customer-support-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
PINECONE_BATCH_SIZE=96
PINECONE_EMBEDDING_MODE=integrated
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_TEXT_FIELD=chunk_text

# Required only when PINECONE_EMBEDDING_MODE=openai.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_JUDGE_PROMPT_VERSION=answer-judge-v1
