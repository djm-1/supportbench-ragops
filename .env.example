APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=*

# Local-first default. Use the Postgres URL below when running docker-compose.
DATABASE_URL=sqlite:///./supportbench.db
# DATABASE_URL=postgresql+psycopg://supportbench:supportbench@localhost:5432/supportbench
# Railway SQLite volume example:
# DATABASE_URL=sqlite:////app/data_runtime/supportbench.db

USE_REAL_MODELS=false
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Pinecone production retrieval. Local vector search is used when disabled.
USE_PINECONE=false
PINECONE_API_KEY=
PINECONE_INDEX=supportbench-ragops-integrated
PINECONE_NAMESPACE=customer-support-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
PINECONE_BATCH_SIZE=96
PINECONE_EMBEDDING_MODE=integrated
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_TEXT_FIELD=chunk_text

# Required only when PINECONE_EMBEDDING_MODE=openai.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
DEFAULT_ANSWER_MODEL=openai_primary

# Answer correctness judge. Use a cheap GPT judge; set deterministic to avoid extra judge API calls.
# Set EVAL_JUDGE_PROVIDER=deterministic to avoid extra judge API calls.
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-5.4-nano
EVAL_JUDGE_PROMPT_VERSION=answer-judge-v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
